# Caddy terminates TLS (automatic Let's Encrypt) and proxies to the memory container.
# MEMORY_DOMAIN comes from .env (e.g. memory.example.com); port 80/443 must be reachable.
{$MEMORY_DOMAIN} {
    encode gzip
    reverse_proxy memory:8000 {
        transport http {
            read_timeout 1800s
            write_timeout 1800s
        }
    }
    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 3
        }
        format json
    }
}
